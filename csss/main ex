		jQuery(function( $ ) {
		    $(document).ready(function() {

				/* Fonction rudimentaire de scroll
				Au scroll de la div wrapper-ecran, ajouter/enlever la classe scrolling à la div subheader  */
				$(document).scroll(function(){
					scrollSticky();
				});

				function scrollSticky(){

				  var scrolling = $('body'),
				      scroll = $(document).scrollTop();

				  if (scroll > 0) scrolling.addClass('scrolling');
				  else scrolling.removeClass('scrolling');

				}
				scrollSticky();


				/* Recuperation d'un script pour afficher le menu ;) */
			    var $header = $('#masthead');
			    var $drawer = $('#menu-drawer');
			    var $cache = $('#hide-body');
			    var $btmenu = $('.bt-menu');

			    function menudisplay(){        
			        if ($header.hasClass('open'))
			        {
			            $header.removeClass('open');
			            $drawer.animate({right: '-'+$drawer.css( "width" )});
			            $cache.stop(true).fadeTo(250,0).fadeOut(0);
			        }
			        else
			        {
			            $header.addClass('open');
			            $drawer.animate({right: 0});
			            $cache.stop(true).fadeTo(250,1);
			        }
			    }
			    $( window ).on('resize',function(){		
			        if (!$header.hasClass('open')){
			        	$drawer.css({right: '-'+$drawer.css( "width" )});
			        }
			    });
			    $btmenu.on('click',function(e)
			    {
			        e.preventDefault();
			        menudisplay();
			    });
			    $cache.on('click',function(e)
			    {
			        e.preventDefault();
			        menudisplay();
			    });


	    		
				

		    });        
		});

