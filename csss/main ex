                    // n'a pas encore été parsé au premier tick.
                    function aknS2Time(s) {
                        var s_total_zeroed = Math.max(s,0);
                        var d = Math.floor(s_total_zeroed/86400);
                        var h = Math.floor((s_total_zeroed-d*86400)/3600);
                        var m = Math.floor((s_total_zeroed-d*86400-h*3600)/60);
                        var s = s_total_zeroed-d*86400-h*3600-m*60;
                        return (d?d+' day'+((d>1)?'s':'')+' ':'')+(h?h+'h ':'')+((h||m)?m+'m ':'')+s+'s';
                    }
                    function aknS2TimeSimple(s) {
                        var s_total_zeroed = Math.max(s,0);
