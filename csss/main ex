                        <script type="6a28c2d98e3e3e00318b9236-text/javascript">
            jQuery(document).ready(function($) {
                var aknMaxSabliers = 10;
                function aknBumpCounter($dest, value) {
                    var $span = $dest.find('span');
                    var from = parseInt($span.text().replace(/\D/g,''))||0;
                    var to = from + value;
                    var steps = 12, i = 0;
                    var itv = setInterval(function() {
                        i++;
                        $span.text(Math.round(from + (to-from)*i/steps));
                        if (i>=steps) clearInterval(itv);
                    }, 40);
                    $dest.addClass('bubbly-button animate');
                    setTimeout(function(){ $dest.removeClass('bubbly-button animate'); }, 500);
                }
                function aknBumpSablier($dest, value) {
                    var $nb = $dest.find('.nb-sabliers');
                    var from = parseInt($nb.text())||0;
                    var to = from + value;
                    for (var i=1; i<=value; i++)
                        (function(v){ setTimeout(function(){ $nb.text(from+v); }, v*100); })(i);
                    $dest.find('.progress-shine span').stop(true).animate({'width': Math.min(Math.round(100*to/aknMaxSabliers),100)+'%'}, Math.max(value*100,300));
                }
                window.aknFlyToCounter = function($fromImg, type, value) {
                    var $dest;
                    if (type=='sablier') {
                        $dest = $('.container-footer .energy-remaining.count-sablier').filter(':visible').first();
                    }
                    else {
                        var counterClass = {gold:'count-gold', gem:'count-gem', reroll:'count-reroll'}[type];
                        if (!counterClass)
                            return;
                        $dest = $('.container-footer .count-gem-dust .'+counterClass).filter(':visible').first();
                        if (!$dest.length)
                            $dest = $('.count-gem-dust .'+counterClass).filter(':visible').first();
                    }
                    if (!$dest.length || !$fromImg || !$fromImg.length || !$fromImg.is(':visible'))
                        return;
                    var from = $fromImg.offset();
                    var w = $fromImg.width();
                    var destOff = $dest.offset();
                    var $clone = $fromImg.clone().appendTo('body').css({
                        position:'absolute', left:from.left+'px', top:from.top+'px',
                        width:w+'px', height:'auto', zIndex:100000, pointerEvents:'none', margin:0
                    });
                    $clone.animate({
                        left:(destOff.left+$dest.outerWidth()/2-11)+'px',
                        top:(destOff.top+$dest.outerHeight()/2-11)+'px',
                        width:'22px', opacity:0.85
                    }, 600, 'swing', function() {
                        $clone.remove();
                        if (type=='sablier')
                            aknBumpSablier($dest, value);
                        else
                            aknBumpCounter($dest, value);
                    });
                };
                // S15 - barre de level (season pass) du header : +N peaches, avec passage de niveau animé
                var aknPeachesPerLevel = 40;
                window.aknBumpSeasonPass = function(nbPeaches) {
                    nbPeaches = parseInt(nbPeaches)||0;
                    var $sp = $('#masthead .season-head .season-progress').filter(':visible').first();
                    if (!nbPeaches || !$sp.length) return;
                    var $level = $sp.find('.value em');
                    var $bar = $sp.find('.progress span');
                    var level = parseInt($level.text())||0;
                    var pct = parseFloat(($bar[0] && $bar[0].style.width)||'0')||0;
                    var progress = Math.round(pct*aknPeachesPerLevel/100);
                    var total = level*aknPeachesPerLevel+progress+nbPeaches;
                    var newLevel = Math.floor(total/aknPeachesPerLevel);
                    var newProgress = total%aknPeachesPerLevel;
                    var bump = function() {
                        $sp.find('.value').addClass('bubbly-button animate');
                        setTimeout(function(){ $sp.find('.value').removeClass('bubbly-button animate'); }, 500);
                    };
                    if (newLevel>level) {
                        // fin du niveau courant → barre pleine, puis nouveau niveau et reprise à la progression restante
                        $bar.stop(true).animate({'width':'100%'}, 300, function() {
                            $level.text(newLevel);
                            bump();
                            // nouveau niveau atteint = au moins la reward free de ce niveau est claimable → notif « coffre dispo »
                            $sp.find('img.exclamation').stop(true).fadeIn(250);
                            $bar.css({'width':'0%'}).animate({'width':Math.round(newProgress/aknPeachesPerLevel*100)+'%'}, 300);
                        });
                    }
                    else {
                        $bar.stop(true).animate({'width':Math.round(newProgress/aknPeachesPerLevel*100)+'%'}, 400);
                        bump();
                    }
                };
                // Vol des peaches depuis $fromPeaches (.peaches) jusqu'à la barre de level : UNE pêche par peach gagnée
                // (retour PO : « 3 fois une pêche qui monte » plutôt que « 🍑 x3 »), envolées décalées, la barre
                // s'incrémente de 1 à chaque arrivée (passage de niveau animé au bon moment). Au-delà de
                // aknPeachesMaxFlying clones, les peaches restantes sont créditées avec la dernière.
                // Durée totale exposée dans window.aknPeachesFlightMs (home.php s'en sert pour retarder le reload).
                var aknPeachesMaxFlying = 12, aknPeachesStagger = 110, aknPeachesFlight = 650;
                window.aknPeachesFlightMs = 0;
                window.aknFlyPeachesToSeasonPass = function($fromPeaches, nbPeaches, onDone) {
                    nbPeaches = parseInt(nbPeaches)||0;
                    var $sp = $('#masthead .season-head .season-progress').filter(':visible').first();
                    if (!nbPeaches || !$sp.length || !$fromPeaches || !$fromPeaches.length || !$fromPeaches.is(':visible')) {
                        if (onDone) onDone(false);
                        return false;
                    }
                    var $img = $fromPeaches.find('img.peach').first();
                    if (!$img.length) { if (onDone) onDone(false); return false; }
                    var from = $img.offset();
                    var imgH = $img.height() || 16;
                    var $dest = $sp.find('.value');
                    var destOff = $dest.offset();
                    var destLeft = destOff.left + $dest.outerWidth()/2 - imgH/2;
                    var destTop = destOff.top + $dest.outerHeight()/2 - imgH/2;
                    var nbFlying = Math.min(nbPeaches, aknPeachesMaxFlying);
                    window.aknPeachesFlightMs = aknPeachesStagger*(nbFlying-1) + aknPeachesFlight + 400;
                    var arrived = 0;
                    for (var i = 0; i < nbFlying; i++) {
                        (function(i) {
                            setTimeout(function() {
                                // léger éventail au départ pour que les pêches ne se superposent pas exactement
                                var spread = (i - (nbFlying-1)/2) * 6;
                                var $clone = $img.clone().appendTo('body').css({
                                    position:'absolute', left:(from.left+spread)+'px', top:from.top+'px',
                                    height:imgH+'px', width:'auto', zIndex:100000, pointerEvents:'none', margin:0
                                });
                                $clone.animate({left:destLeft+'px', top:destTop+'px', opacity:0.9}, aknPeachesFlight, 'swing', function() {
                                    $clone.remove();
                                    arrived++;
                                    // dernière pêche visible : elle porte aussi les peaches non animées (au-delà du plafond)
                                    var credit = (arrived===nbFlying) ? (nbPeaches - (nbFlying-1)) : 1;
                                    window.aknBumpSeasonPass(credit);
                                    if (arrived===nbFlying && onDone) onDone(true);
                                });
                            }, i*aknPeachesStagger);
                        })(i);
                    }
                    return true;
                };
                window.aknFlyCreditedResources = function($fromImg, credited) {
                    var i = 0;
                    (credited||[]).forEach(function(r) {
                        var value = parseInt(r.value)||0;
                        if (!value || !{gold:1,gem:1,reroll:1,sablier:1}[r.type])
                            return;
                        (function(type,val,delay) {
                            setTimeout(function(){ window.aknFlyToCounter($fromImg, type, val); }, delay);
                        })(r.type, value, i*150);
                        i++;
                    });
                };
            });
            </script>


