                        var h = Math.floor((s_total_zeroed-d*86400)/3600);
                        var m = Math.floor((s_total_zeroed-d*86400-h*3600)/60);
                        var s = s_total_zeroed-d*86400-h*3600-m*60;
                        if (d)
