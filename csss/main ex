                        <script type="6a28c2d98e3e3e00318b9236-text/javascript">
                        (function(){
                          var root  = document.getElementById('bblChest');
                          var imgs  = Array.prototype.slice.call(root.querySelectorAll('.bbl-chest__img'));
                          var flash = root.querySelector('.bbl-chest__flash');
                          var canvas = document.getElementById('bblParticles');

                          // ----- Moteur de particules (burst à l'ouverture) -----
                          var ctx = canvas.getContext('2d');
                          var particles = [];
                          var rafId = null;
                          var COLORS = ['#FFCC00','#F9FF12','#FF9B2E','#FF0B6F','#A200FF','#ffffff'];
                          var reduceMotion = window.matchMedia &&
                                             window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                          function sizeCanvas(){
                            var r = canvas.getBoundingClientRect();
                            canvas.width  = Math.max(1, r.width);
                            canvas.height = Math.max(1, r.height);
                          }

                          function burst(){
                            if(reduceMotion) return;
                            sizeCanvas();
                            var cx = canvas.width * 0.5;
                            var cy = canvas.height * 0.45;     // centre du coffre
                            var n = 70;
                            for(var i=0;i<n;i++){
                              var ang = (Math.PI*2) * (i/n) + (Math.random()-0.5)*0.3;
                              var speed = 3 + Math.random()*6;
                              particles.push({
                                x:cx, y:cy,
                                vx:Math.cos(ang)*speed,
                                vy:Math.sin(ang)*speed - (2+Math.random()*3), // biais vers le haut
                                size:2 + Math.random()*4,
                                life:1,
                                decay:0.012 + Math.random()*0.02,
                                color:COLORS[(Math.random()*COLORS.length)|0],
                                spin:(Math.random()-0.5)*0.3,
                                rot:Math.random()*Math.PI
                              });
                            }
                            if(!rafId) rafId = requestAnimationFrame(tick);
                          }

                          function tick(){
                            ctx.clearRect(0,0,canvas.width,canvas.height);
                            var alive = false;
                            for(var i=0;i<particles.length;i++){
                              var p = particles[i];
                              if(p.life<=0) continue;
                              alive = true;
                              p.vy += 0.18;            // gravité
                              p.vx *= 0.99;
                              p.x += p.vx;
                              p.y += p.vy;
                              p.life -= p.decay;
                              p.rot += p.spin;
                              ctx.save();
                              ctx.globalAlpha = Math.max(0,p.life);
                              ctx.translate(p.x,p.y);
                              ctx.rotate(p.rot);
                              ctx.fillStyle = p.color;
                              ctx.shadowColor = p.color;
                              ctx.shadowBlur = 8;
                              var s = p.size;
                              ctx.fillRect(-s/2,-s/2,s,s);   // petite paillette carrée
                              ctx.restore();
                            }
                            if(alive){
                              rafId = requestAnimationFrame(tick);
                            } else {
                              ctx.clearRect(0,0,canvas.width,canvas.height);
                              particles.length = 0;
                              rafId = null;
                            }
                          }

                          window.addEventListener('resize', function(){ if(rafId) sizeCanvas(); });

                          // ----- Réglages "le coffre résiste" -----
                          var MIN_CLICKS = 1;   // clics minimum pour franchir un palier
                          var MAX_CLICKS = 3;   // clics maximum
                          function clicksNeeded(){
                            return Math.floor(Math.random()*(MAX_CLICKS-MIN_CLICKS+1)) + MIN_CLICKS;
                          }

                          var TOTAL = imgs.length;     // 4
                          var step = 1;                // étape affichée (1..4)
                          var clicksDone = 0;          // clics accumulés sur le palier courant
                          var target = clicksNeeded(); // clics requis pour le prochain palier
                          var locked = false;

                          function show(n){
                            imgs.forEach(function(img){
                              var active = (+img.dataset.step === n);
                              img.classList.toggle('is-active', active);
                              if(active){
                                img.classList.remove('is-pop'); void img.offsetWidth;
                                img.classList.add('is-pop');
                              }
                            });
                            root.classList.toggle('is-final', n === TOTAL);
                          }

                          function resist(){
                            // clic qui ne franchit pas encore le palier : le coffre tressaille
                            root.classList.remove('is-resist'); void root.offsetWidth;
                            root.classList.add('is-resist');
                            setTimeout(function(){ root.classList.remove('is-resist'); }, 200);
                          }

                          function breakStage(){
                            locked = true;
                            step++;
                            clicksDone = 0;
                            target = clicksNeeded();

                            var isFinal = (step === TOTAL);

                            root.classList.add('is-shaking');
                            flash.classList.remove('is-flash','is-flash-final'); void flash.offsetWidth;
                            flash.classList.add(isFinal ? 'is-flash-final' : 'is-flash');

                            setTimeout(function(){
                              show(step);
                              if(isFinal) burst();   // jaillissement de particules pile sur l'ouverture
                            }, 140);

                            setTimeout(function(){
                              root.classList.remove('is-shaking');
                              flash.classList.remove('is-flash','is-flash-final');
                              locked = false;
                              if(isFinal){
                                // coffre ouvert -> le jeu peut peupler #bblReward
                                root.dispatchEvent(new CustomEvent('bbl:opened', {bubbles:true}));
                              }
                            }, isFinal ? 620 : 430);
                          }

                          function onTap(){
                            if(locked) return;

                            if(step >= TOTAL){
                              // déjà ouvert : clic = on signale (ex: fermer / réclamer)
                              root.dispatchEvent(new CustomEvent('bbl:reward', {bubbles:true}));
                              return;
                            }

                            clicksDone++;
                            if(clicksDone >= target){
                              breakStage();
                            } else {
                              resist();
                            }
                          }

                          root.addEventListener('click', onTap);
                          root.addEventListener('keydown', function(e){
                            if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); onTap(); }
                          });

                          // ----- Intégration S15 : reset + swap du type de coffre + injection des rewards -----
                          var CHEST_BASE = 'https://play.boobylegends.com/wp-content/themes/child-roulette/img/ressources/chests-anim/chest-';
                          window.bblChestSet = function(chestType, rewardsHtml){
                            imgs.forEach(function(img){ img.src = CHEST_BASE + chestType + img.dataset.step + '.webp'; });
                            var inner = document.querySelector('#bblReward .bbl-reward__inner');
                            if (inner) inner.innerHTML = rewardsHtml || '';
                            if (typeof(adaptFontSize)!='undefined') adaptFontSize();
                            step = 1; clicksDone = 0; target = clicksNeeded(); locked = false;
                            root.classList.remove('is-final','is-shaking','is-resist');
                            show(1);
                          };
                          // bbl:reward (clic sur coffre déjà ouvert) - ⚠️ comportement provisoire en attendant le PO : ferme la popin
                          root.addEventListener('bbl:reward', function(){ togglePopup('popup-akn-claim-rewards'); });

                          show(1);

                        })();
                        </script>
